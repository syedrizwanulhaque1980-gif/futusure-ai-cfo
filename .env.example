# Copy this file to .env and fill in your keys.
# Never commit the real .env file.

# Public URL of this app once deployed (used for Stripe redirect URLs)
CLIENT_URL=https://your-app.up.railway.app

# Claude (for live AI extraction & chat)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Razorpay (INR payments — India)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# Stripe (international payments — USD/EUR/GBP etc.)
STRIPE_SECRET_KEY=sk_live_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
# Publishable key is safe to expose to the browser; Vite needs the VITE_ prefix
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxx

# Optional
# PORT=3001
# CLAUDE_MODEL=claude-sonnet-4-20250514
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
